    // --- Collision & Accurate Laser Raycasting ---
    function resolveCircleBox(ent, b) {
      const cx = Math.max(b.x1, Math.min(ent.x, b.x2)), cz = Math.max(b.z1, Math.min(ent.z, b.z2));
      const dx = ent.x - cx, dz = ent.z - cz, dSq = dx*dx + dz*dz;
      if (dSq < ent.r * ent.r) {
        const d = Math.sqrt(dSq);
        if (d > 0.0001) { ent.x += (dx / d) * (ent.r - d); ent.z += (dz / d) * (ent.r - d); }
        else {
          const l = ent.x - b.x1, r = b.x2 - ent.x, t = ent.z - b.z1, bt = b.z2 - ent.z, m = Math.min(l, r, t, bt);
          if (m === l) ent.x = b.x1 - ent.r; else if (m === r) ent.x = b.x2 + ent.r;
          else if (m === t) ent.z = b.z1 - ent.r; else ent.z = b.z2 + ent.r;
        }
        return true;
      }
      return false;
    }

    function segHitsBox(x1, z1, x2, z2, b) {
      let t0 = 0, t1 = 1;
      const dx = x2 - x1, dz = z2 - z1;
      const p = [-dx, dx, -dz, dz], q = [x1 - b.x1, b.x2 - x1, z1 - b.z1, b.z2 - z1];
      for (let i = 0; i < 4; i++) {
        if (Math.abs(p[i]) < 1e-8) { if (q[i] < 0) return false; }
        else {
          const t = q[i] / p[i];
          if (p[i] < 0) { if (t > t1) return false; if (t > t0) t0 = t; }
          else { if (t < t0) return false; if (t < t1) t1 = t; }
        }
      }
      return t0 <= t1;
    }

    function hasLOS(x1, z1, x2, z2) {
      for (let i = 0; i < colliders.length; i++) if (colliders[i].tall && segHitsBox(x1, z1, x2, z2, colliders[i])) return false;
      return true;
    }
    function inTallWall(x, z) {
      for (let i = 0; i < colliders.length; i++) {
        const c = colliders[i];
        if (c.tall && x >= c.x1 && x <= c.x2 && z >= c.z1 && z <= c.z2) return true;
      }
      return false;
    }

    function castLaserLength(u, maxDist) {
      const sin = Math.sin(u.yaw), cos = Math.cos(u.yaw);
      const ox = u.x + cos * u.vis.gunOffX + sin * u.vis.gunOffZ;
      const oz = u.z - sin * u.vis.gunOffX + cos * u.vis.gunOffZ;
      let best = maxDist;
      for (let step = 1; step <= 26; step++) {
        const d = (maxDist * step) / 26;
        if (inTallWall(ox + sin * d, oz + cos * d)) { best = d; break; }
      }
      for (let i = 0; i < enemies.length; i++) {
        const e = enemies[i]; if (e.hp <= 0) continue;
        const vx = e.x - ox, vz = e.z - oz;
        const proj = vx * sin + vz * cos;
        if (proj > 0 && proj < best) {
          const perp = Math.abs(vx * cos - vz * sin);
          if (perp <= e.r + 0.15) best = proj;
        }
      }
      return best;
    }

