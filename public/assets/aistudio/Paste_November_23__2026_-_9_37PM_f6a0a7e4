<script>
(() => {
  const statusEl = document.getElementById('boot-status');
  const startBtn = document.getElementById('start-btn');
  function setStatus(msg, err = false) {
    statusEl.textContent = msg;
    statusEl.classList.toggle('err', err);
  }
  window.addEventListener('error', (ev) => setStatus('JS Ошибка: ' + ev.message, true));

  const SOURCES = [
    'https://unpkg.com/three@0.147.0/build/three.min.js',
    'https://cdn.jsdelivr.net/npm/three@0.147.0/build/three.min.js',
    'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js',
    'https://raw.githack.com/mrdoob/three.js/r147/build/three.min.js',
    './three.min.js'
  ];

  function loadScript(url, ms = 4500) {
    return new Promise((res, rej) => {
      const s = document.createElement('script');
      let done = false;
      const t = setTimeout(() => { if (!done) { done = true; s.remove(); rej(); } }, ms);
      s.onload = () => { if (!done) { done = true; clearTimeout(t); window.THREE ? res() : rej(); } };
      s.onerror = () => { if (!done) { done = true; clearTimeout(t); s.remove(); rej(); } };
      s.src = url; document.head.appendChild(s);
    });
  }

  (async () => {
    for (let i = 0; i < SOURCES.length; i++) {
      setStatus(`Подключение Three.js (${i + 1}/${SOURCES.length})...`);
      try {
        await loadScript(SOURCES[i]);
        setStatus(`✓ Three.js r${THREE.REVISION} загружен. Сборка City Pop 3D-сцены...`);
        initScene();
        setStatus(`✓ 3D-сцена готова! Нажмите «НАЧАТЬ» (или [V] для свободного осмотра).`);
        startBtn.disabled = false;
        startBtn.textContent = 'ВОЙТИ НА ПЕРЕКРЁСТОК';
        return;
      } catch (_) {}
    }
    setStatus('Не удалось загрузить Three.js ни с одного CDN.', true);
  })();

  // =========================================================================
  // ОСНОВНАЯ 3D-СЦЕНА (ART-DIRECTED CITY POP NIGHT + ALIEN SWARM CAMERA)
  // =========================================================================
  function initScene() {
    // --- Audio Synth ---
    let audioCtx = null, muted = false;
    function initAudio() {
      if (!audioCtx) { const AC = window.AudioContext || window.webkitAudioContext; if (AC) audioCtx = new AC(); }
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
    }
    function playSfx(type) {
      if (muted || !audioCtx) return;
      const now = audioCtx.currentTime;
      const osc = audioCtx.createOscillator(), g = audioCtx.createGain();
      osc.connect(g); g.connect(audioCtx.destination);
      if (type === 'rifle') {
        osc.type = 'sawtooth'; osc.frequency.setValueAtTime(240 + Math.random()*55, now);
        osc.frequency.exponentialRampToValueAtTime(48, now + 0.055);
        g.gain.setValueAtTime(0.05, now); g.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
        osc.start(now); osc.stop(now + 0.065);
      } else if (type === 'heavy') {
        osc.type = 'square'; osc.frequency.setValueAtTime(140, now);
        osc.frequency.exponentialRampToValueAtTime(36, now + 0.08);
        g.gain.setValueAtTime(0.06, now); g.gain.exponentialRampToValueAtTime(0.001, now + 0.085);
        osc.start(now); osc.stop(now + 0.09);
      } else if (type === 'sniper') {
        osc.type = 'triangle'; osc.frequency.setValueAtTime(860, now);
        osc.frequency.exponentialRampToValueAtTime(80, now + 0.25);
        g.gain.setValueAtTime(0.14, now); g.gain.exponentialRampToValueAtTime(0.001, now + 0.26);
        osc.start(now); osc.stop(now + 0.27);
      } else if (type === 'boom') {
        osc.type = 'sawtooth'; osc.frequency.setValueAtTime(110, now);
        osc.frequency.exponentialRampToValueAtTime(20, now + 0.44);
        g.gain.setValueAtTime(0.18, now); g.gain.exponentialRampToValueAtTime(0.001, now + 0.45);
        osc.start(now); osc.stop(now + 0.46);
      } else if (type === 'heal' || type === 'roll' || type === 'flare') {
        osc.type = type === 'flare' ? 'triangle' : 'sine';
        const f1 = type === 'heal' ? 460 : type === 'flare' ? 520 : 200;
        const f2 = type === 'heal' ? 920 : type === 'flare' ? 240 : 85;
        osc.frequency.setValueAtTime(f1, now); osc.frequency.exponentialRampToValueAtTime(f2, now + 0.2);
        g.gain.setValueAtTime(0.075, now); g.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
        osc.start(now); osc.stop(now + 0.23);
      }
    }
    document.getElementById('mute-btn').addEventListener('click', (e) => {
      muted = !muted; e.target.textContent = muted ? 'ЗВУК: ВЫКЛ' : 'ЗВУК: ВКЛ';
    });

    let toastTimer = null;
    function showToast(msg, col = '#4ce0e8') {
      const el = document.getElementById('toast');
      el.textContent = msg; el.style.borderColor = col; el.style.opacity = '1';
      clearTimeout(toastTimer); toastTimer = setTimeout(() => { el.style.opacity = '0'; }, 2000);
    }

    // --- Renderer & Atmospheric Scene ---
    const wrap = document.getElementById('canvas-wrap');
    let renderer;
    try { renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' }); }
    catch (_) { renderer = new THREE.WebGLRenderer({ antialias: false }); }
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.22;
    if (THREE.sRGBEncoding) renderer.outputEncoding = THREE.sRGBEncoding;
    wrap.appendChild(renderer.domElement);

