        updateCamera(dt, null);
        return;
      }

      if (!running || gameOver || victory) { updateCamera(dt, null); return; }

      timeElapsed += dt;
      if (shakeTime > 0) shakeTime = Math.max(0, shakeTime - dt);
      if (rallyBuffTimer > 0) rallyBuffTimer = Math.max(0, rallyBuffTimer - dt);

      if (!squad[activeIdx] || squad[activeIdx].down) {
        const alive = squad.findIndex(m => !m.down);
        if (alive === -1) { triggerEnd(false); return; }
        activeIdx = alive;
      }
      const leader = squad[activeIdx];

      raycaster.setFromCamera(mouseNDC, camera);
      raycaster.ray.intersectPlane(aimPlane, aimPoint);
      aimReticle.position.set(aimPoint.x, 0.06, aimPoint.z);

      // Movement / Roll
      if (leader.rollTimer > 0) {
        leader.rollTimer = Math.max(0, leader.rollTimer - dt);
        leader.x += leader.rollVx * dt; leader.z += leader.rollVz * dt;
      } else {
        let ix = 0, iz = 0;
        if (keys['KeyW'] || keys['ArrowUp']) iz -= 1;
        if (keys['KeyS'] || keys['ArrowDown']) iz += 1;
        if (keys['KeyA'] || keys['ArrowLeft']) ix -= 1;
        if (keys['KeyD'] || keys['ArrowRight']) ix += 1;
        if (ix || iz) {
          const len = Math.hypot(ix, iz), nx = ix/len, nz = iz/len, c = Math.cos(camYaw), s = Math.sin(camYaw);
          const boost = rallyBuffTimer > 0 ? 1.24 : 1.0;
          leader.x += (nx*c + nz*s) * leader.speed * boost * dt;
          leader.z += (-nx*s + nz*c) * leader.speed * boost * dt;
        }
      }

      const lastB = leaderTrail[leaderTrail.length - 1];
      if (!lastB || Math.hypot(leader.x - lastB.x, leader.z - lastB.z) > 1.4) {
        leaderTrail.push({ x: leader.x, z: leader.z });
        if (leaderTrail.length > 35) leaderTrail.shift();
      }

      // Squad Loop
      squad.forEach((u, idx) => {
        if (u.skillCd > 0) u.skillCd = Math.max(0, u.skillCd - dt);
        if (u.fireCd > 0) u.fireCd = Math.max(0, u.fireCd - dt);
        if (u.rollCd > 0) u.rollCd = Math.max(0, u.rollCd - dt);
        if (u.flashT > 0) { u.flashT = Math.max(0, u.flashT - dt); u.vis.muzzleFlash.material.opacity = u.flashT / 0.06; }

        const isActive = idx === activeIdx;
        u.vis.ring.material.opacity = isActive ? 0.92 : 0.22;
        u.vis.ring.scale.setScalar(isActive ? 1.15 : 0.9);
        u.vis.laser.visible = !u.down; u.vis.laserDot.visible = !u.down;

        if (u.down) { u.vis.group.rotation.x = Math.PI / 2; u.vis.group.position.set(u.x, 0.24, u.z); return; }

        const px = u.x, pz = u.z;
        if (!isActive) {
          const sx = leader.x + u.offset.x, sz = leader.z + u.offset.z;
          let gx = sx, gz = sz;
          if (!hasLOS(u.x, u.z, sx, sz)) {
            for (let b = leaderTrail.length - 1; b >= 0; b--) {
              if (hasLOS(u.x, u.z, leaderTrail[b].x, leaderTrail[b].z)) { gx = leaderTrail[b].x; gz = leaderTrail[b].z; break; }
            }
          }
          const dx = gx - u.x, dz = gz - u.z, d = Math.hypot(dx, dz);
          if (d > 0.7) {
            const spd = Math.min(d * 5.2, u.speed * (d > 6.5 ? 1.3 : 1.0) * (rallyBuffTimer > 0 ? 1.2 : 1));
            u.x += (dx/d)*spd*dt; u.z += (dz/d)*spd*dt;
          }
        }

        squad.forEach(o => {
          if (o === u || o.down) return;
          const dx = u.x - o.x, dz = u.z - o.z, d = Math.hypot(dx, dz), minD = u.r + o.r + 0.35;
          if (d > 0.01 && d < minD) { const p = (minD - d) * 0.45; u.x += (dx/d)*p; u.z += (dz/d)*p; }
        });
        for (let p = 0; p < 2; p++) for (let i = 0; i < colliders.length; i++) resolveCircleBox(u, colliders[i]);

        if (u.rollTimer <= 0) {
          for (let i = 0; i < acidPools.length; i++) {
            if (Math.hypot(u.x - acidPools[i].x, u.z - acidPools[i].z) < acidPools[i].r) {
              u.hp -= 15 * dt;
              if (u.hp <= 0) { u.hp = 0; u.down = true; showToast(u.name + ' РАНЕН!', '#ff384c'); }
            }
          }
        }

        let target = null, bestD = u.range;
        if (isActive) { u.yaw = Math.atan2(aimPoint.x - u.x, aimPoint.z - u.z); }
        else {
          for (let i = 0; i < enemies.length; i++) {
            const e = enemies[i]; if (e.hp <= 0) continue;
            const d = Math.hypot(e.x - u.x, e.z - u.z);
            if (d < bestD && hasLOS(u.x, u.z, e.x, e.z)) { bestD = d; target = e; }
          }
          u.yaw = target ? Math.atan2(target.x - u.x, target.z - u.z) : Math.atan2(aimPoint.x - u.x, aimPoint.z - u.z);
        }

        // Accurate Clipped 3D Laser Length + Impact Dot
        const lLen = castLaserLength(u, isActive ? 22 : 14);
        const lPos = u.vis.laser.geometry.attributes.position.array;
        lPos[5] = u.vis.gunOffZ + lLen;
        u.vis.laser.geometry.attributes.position.needsUpdate = true;
        u.vis.laserDot.position.set(u.vis.gunOffX, 1.16, u.vis.gunOffZ + lLen);

        const wantsFire = (isActive && mouseDown && u.rollTimer <= 0) || (!isActive && target !== null);
        if (wantsFire && u.fireCd <= 0) {
          u.fireCd = u.fireRate * (rallyBuffTimer > 0 ? 0.62 : 1.0);
          u.flashT = 0.06;
          const ang = u.yaw + (Math.random() - 0.5) * u.spread;
          const spd = u.role === 'sniper' ? 54 : 42;
          const bx = u.x + Math.sin(ang) * 1.15, bz = u.z + Math.cos(ang) * 1.15;
          const bMesh = new THREE.Mesh(bulletGeo, new THREE.MeshBasicMaterial({ color: u.hex }));
          bMesh.position.set(bx, 1.16, bz); bMesh.rotation.y = ang; scene.add(bMesh);
          bullets.push({ kind: 'bullet', x: bx, z: bz, vx: Math.sin(ang)*spd, vz: Math.cos(ang)*spd, dmg: u.dmg, life: u.range/spd, pierce: u.role === 'sniper', mesh: bMesh });
          flashLight.color.setHex(u.hex); flashLight.position.set(bx, 1.4, bz); flashLight.intensity = 3.0;
          playSfx(u.role === 'sniper' ? 'sniper' : u.role === 'heavy' ? 'heavy' : 'rifle');
          enemies.forEach(e => { if (!e.awake && Math.hypot(e.x - u.x, e.z - u.z) < 22) e.awake = true; });
        }

        u.vis.group.position.set(u.x, u.rollTimer > 0 ? 0.45 : 0, u.z);
        u.vis.group.rotation.y = u.yaw;
        u.vis.group.rotation.x = u.rollTimer > 0 ? (1 - u.rollTimer / 0.27) * Math.PI * 2 : 0;
        if (Math.hypot(u.x - px, u.z - pz) > 0.01 && u.rollTimer <= 0) {
          const sw = Math.sin(timeElapsed * 16 + idx) * 0.55;
          u.vis.legL.rotation.x = sw; u.vis.legR.rotation.x = -sw;
        } else { u.vis.legL.rotation.x *= 0.8; u.vis.legR.rotation.x *= 0.8; }
      });

      // Pickups
      pickups.forEach(pk => {
        if (pk.taken) return;
        pk.mesh.rotation.y += dt * 1.8; pk.mesh.position.y = 0.6 + Math.sin(tNow * 3) * 0.14;
        if (Math.hypot(leader.x - pk.x, leader.z - pk.z) < 2.2) {
          pk.taken = true; scene.remove(pk.mesh); playSfx('heal'); showToast(pk.label, '#6ee782');
          if (pk.kind === 'medkit') squad.forEach(m => { m.down = false; m.hp = m.maxHp; });
          else { flareAmmo += 2; squad.forEach(m => { if (!m.down) m.hp = Math.min(m.maxHp, m.hp + 50); }); }
        }
      });

      // Med Beacons
      if (medBeacons.length > 0) { medLight.position.set(medBeacons[0].x, 1.5, medBeacons[0].z); medLight.intensity = 2.6 + Math.sin(tNow*8)*0.6; }
      else medLight.intensity = 0;
      for (let i = medBeacons.length - 1; i >= 0; i--) {
        const mb = medBeacons[i]; mb.life -= dt; mb.tick += dt; mb.mesh.rotation.y += dt * 1.5;
        if (mb.tick >= 0.5) {
          mb.tick = 0;
          squad.forEach(m => {
            if (Math.hypot(m.x - mb.x, m.z - mb.z) <= mb.r) {
              if (m.down) { m.down = false; m.hp = Math.round(m.maxHp * 0.5); }
              else m.hp = Math.min(m.maxHp, m.hp + 13);
            }
          });
        }
        if (mb.life <= 0) { scene.remove(mb.mesh); medBeacons.splice(i, 1); }
      }

      // Flares
      if (flares.length > 0) {
        const f = flares[flares.length - 1];
        flareLight.position.set(f.x, 1.2, f.z);
        flareLight.intensity = 3.5 + Math.random() * 1.2;
      } else flareLight.intensity = 0;
      for (let i = flares.length - 1; i >= 0; i--) {
        const f = flares[i]; f.life -= dt;
        f.halo.scale.setScalar(3.8 + Math.random() * 0.9);
        if (Math.random() < 0.32) spawnBurst(f.x, 0.35, f.z, 0xff5a72, 1, 1.6, 0.45);
        if (f.life <= 0) { scene.remove(f.mesh); scene.remove(f.halo); scene.remove(f.refl); flares.splice(i, 1); }
      }

      // Projectiles
      for (let i = bullets.length - 1; i >= 0; i--) {
        const b = bullets[i];
        if (b.kind === 'grenade') {
          b.t += dt; const p = Math.min(1, b.t / b.dur);
          b.x = b.sx + (b.tx - b.sx)*p; b.z = b.sz + (b.tz - b.sz)*p;
          b.y = 1.3*(1-p) + 4.8*4*p*(1-p) + 0.25; b.mesh.position.set(b.x, b.y, b.z);
          if (p >= 1 || inTallWall(b.x, b.z)) { explodeGrenade(b.x, b.z); scene.remove(b.mesh); bullets.splice(i, 1); }
          continue;
        }
        b.x += b.vx * dt; b.z += b.vz * dt; b.life -= dt;
        b.mesh.position.set(b.x, b.kind === 'acid' ? 0.9 : 1.16, b.z);
        if (b.kind === 'acid') {
          if (b.life <= 0 || inTallWall(b.x, b.z)) {
            const pm = new THREE.Mesh(new THREE.CircleGeometry(1.85, 18), new THREE.MeshBasicMaterial({ color: 0x6ee750, transparent: true, opacity: 0.46 }));
            pm.rotation.x = -Math.PI / 2; pm.position.set(b.x, 0.06, b.z); scene.add(pm);
            acidPools.push({ x: b.x, z: b.z, r: 1.85, life: 5.2, mesh: pm });
            scene.remove(b.mesh); bullets.splice(i, 1); continue;
          }
          for (let s = 0; s < squad.length; s++) {
            const u = squad[s];
            if (!u.down && u.rollTimer <= 0 && Math.hypot(u.x - b.x, u.z - b.z) < u.r + 0.4) {
              u.hp = Math.max(0, u.hp - 14);
              if (u.hp <= 0) { u.down = true; showToast(u.name + ' РАНЕН!', '#ff384c'); }
              scene.remove(b.mesh); bullets.splice(i, 1); break;
            }
          }
          continue;
        }
        if (b.life <= 0 || inTallWall(b.x, b.z)) { spawnBurst(b.x, 1.15, b.z, 0xf5b971, 2, 4, 0.16); scene.remove(b.mesh); bullets.splice(i, 1); continue; }
        for (let j = 0; j < enemies.length; j++) {
          const e = enemies[j]; if (e.hp <= 0) continue;
          if (Math.hypot(e.x - b.x, e.z - b.z) <= e.r + 0.36) { damageEnemy(e, b.dmg, b.pierce); scene.remove(b.mesh); bullets.splice(i, 1); break; }
        }
      }

      for (let i = acidPools.length - 1; i >= 0; i--) {
        acidPools[i].life -= dt; acidPools[i].mesh.material.opacity = Math.min(0.46, acidPools[i].life * 0.4);
        if (acidPools[i].life <= 0) { scene.remove(acidPools[i].mesh); acidPools.splice(i, 1); }
      }

      // Enemies
      let bossRef = null;
      for (let i = enemies.length - 1; i >= 0; i--) {
        const e = enemies[i]; if (e.hp <= 0) { enemies.splice(i, 1); continue; }
        if (e.hitFlash > 0) {
          e.hitFlash = Math.max(0, e.hitFlash - dt);
          e.vis.bodyMat.emissive.setHex(e.hitFlash > 0 ? 0xffffff : 0x000000);
          e.vis.bodyMat.emissiveIntensity = e.hitFlash > 0 ? 0.7 : 0;
        }
        if (e.atkCd > 0) e.atkCd = Math.max(0, e.atkCd - dt);
        if (e.spitCd > 0) e.spitCd = Math.max(0, e.spitCd - dt);
        if (e.steerTimer > 0) e.steerTimer = Math.max(0, e.steerTimer - dt);
        if (e.boss) bossRef = e;

        let target = null, minD = Infinity;
        squad.forEach(u => { if (u.down) return; const d = Math.hypot(u.x - e.x, u.z - e.z); if (d < minD) { minD = d; target = u; } });
        if (!target) continue;

        if (!e.awake && ((minD < 24 && hasLOS(e.x, e.z, target.x, target.z)) || minD < 12)) e.awake = true;
        let gx = target.x, gz = target.z, lured = false;
        for (let f = 0; f < flares.length; f++) {
          if (flares[f].lure && Math.hypot(flares[f].x - e.x, flares[f].z - e.z) < 20) { e.awake = true; lured = true; gx = flares[f].x; gz = flares[f].z; break; }
        }

        if (e.awake) {
          const dx = gx - e.x, dz = gz - e.z, dist = Math.hypot(dx, dz) || 1;
          e.yaw = Math.atan2(dx, dz);
          if (e.ranged && !lured && dist < 17 && dist > 6 && hasLOS(e.x, e.z, target.x, target.z)) {
            if (e.spitCd <= 0) {
              e.spitCd = 3.2; const spd = 15.5;
              const am = new THREE.Mesh(acidGeo, new THREE.MeshBasicMaterial({ color: 0x7cff57 }));
              am.position.set(e.x, 1.0, e.z); scene.add(am);
              bullets.push({ kind: 'acid', x: e.x, z: e.z, vx: (dx/dist)*spd, vz: (dz/dist)*spd, life: dist/spd, mesh: am });
            }
          } else if (dist > e.r + (lured ? 1.4 : target.r + 0.25)) {
            let vx = dx / dist, vz = dz / dist;
            if (e.steerTimer > 0) { const sx = -vz*e.steerDir, sz = vx*e.steerDir; vx = vx*0.35 + sx*0.85; vz = vz*0.35 + sz*0.85; }
            const px = e.x, pz = e.z;
            e.x += vx * e.speed * dt; e.z += vz * e.speed * dt;
            let blocked = false;
            for (let p = 0; p < 2; p++) for (let c = 0; c < colliders.length; c++) if (resolveCircleBox(e, colliders[c])) blocked = true;
            if (blocked && Math.hypot(e.x - px, e.z - pz) < e.speed * dt * 0.35) e.steerTimer = 0.55;
          }
          for (let j = i - 1; j >= 0; j--) {
            const o = enemies[j], sdx = e.x - o.x, sdz = e.z - o.z, sd = Math.hypot(sdx, sdz), minS = e.r + o.r;
            if (sd > 0.01 && sd < minS) { const p = (minS - sd) * 0.4; e.x += (sdx/sd)*p; e.z += (sdz/sd)*p; o.x -= (sdx/sd)*p; o.z -= (sdz/sd)*p; }
          }
          if (!lured && minD <= e.r + target.r + 0.55 && e.atkCd <= 0 && target.rollTimer <= 0) {
            e.atkCd = e.boss ? 1.1 : 0.85; target.hp -= e.dmg;
            addShake(e.boss ? 0.5 : 0.2, 0.14); spawnBurst(target.x, 1.0, target.z, 0xff384c, 5, 5, 0.25);
            if (target.hp <= 0) { target.hp = 0; target.down = true; showToast(target.name + ' РАНЕН! НУЖЕН МЕД-МАЯК [2]', '#ff384c'); }
          }
        }

        e.vis.group.position.set(e.x, 0, e.z); e.vis.group.rotation.y = e.yaw;
        if (e.awake) {
          const sw = Math.sin(timeElapsed * (e.type === 'runner' ? 16 : 9) + i) * 0.52;
          e.vis.legL.rotation.x = sw; e.vis.legR.rotation.x = -sw;
        }
        if (!e.boss && e.hp < e.maxHp) {
          e.vis.hpBg.visible = true; e.vis.hpBar.visible = true;
          e.vis.hpBg.lookAt(camera.position); e.vis.hpBar.lookAt(camera.position);
          e.vis.hpBar.scale.x = Math.max(0.01, e.hp / e.maxHp);
        }
      }

      // Phase Progression!
      if (enemies.length === 0) {
        if (phase === 1) spawnPhase(2);
        else if (phase === 2) spawnPhase(3);
      }

      // Boss Bar
      const bossWrap = document.getElementById('boss-bar-wrap');
      if (bossRef) {
        bossWrap.style.display = 'block';
        const pct = Math.max(0, Math.round((bossRef.hp / bossRef.maxHp) * 100));
        document.getElementById('boss-fill').style.width = pct + '%';
        document.getElementById('boss-hp-text').textContent = pct + '%';
      } else bossWrap.style.display = 'none';

      // FX Update
      for (let i = fxList.length - 1; i >= 0; i--) {
        const f = fxList[i]; f.life -= dt; const a = Math.max(0, f.life / f.maxLife);
        if (f.kind === 'spark') {
          f.vy -= 14 * dt; f.mesh.position.x += f.vx*dt; f.mesh.position.y = Math.max(0.06, f.mesh.position.y + f.vy*dt); f.mesh.position.z += f.vz*dt; f.mat.opacity = a;
        } else if (f.kind === 'ring') { const sc = 1 + (1 - a) * f.maxScale; f.mesh.scale.set(sc, sc, 1); f.mat.opacity = a; }
        else if (f.kind === 'beam') { f.mat.opacity = a; f.mesh.scale.set(a, 1, a); }
        if (f.life <= 0) { scene.remove(f.mesh); fxList.splice(i, 1); }
      }

      // Extraction Victory
      if (bossDefeated && enemies.length === 0) {
        evacRing.scale.setScalar(0.96 + Math.sin(tNow * 5) * 0.06);
        if (Math.hypot(leader.x - EVAC.x, leader.z - EVAC.z) < EVAC.r) { triggerEnd(true); return; }
      }

      updateCamera(dt, leader);
      updateHUD(leader);
    }

    function updateCamera(dt, leader) {
      if (!inspectMode) {
        let tx = -2.0, tz = 4.5;
        if (leader) {
          tx = leader.x + Math.max(-4.5, Math.min(4.5, (aimPoint.x - leader.x) * 0.28));
          tz = leader.z + Math.max(-4.5, Math.min(4.5, (aimPoint.z - leader.z) * 0.28));
        }
        camTarget.x += (tx - camTarget.x) * Math.min(1, dt * 6.5);
        camTarget.z += (tz - camTarget.z) * Math.min(1, dt * 6.5);
      }

      const horiz = Math.cos(camPitch) * camDist;
      const vert  = Math.sin(camPitch) * camDist;
      const dx = camTarget.x + Math.sin(camYaw) * horiz;
      const dy = camTarget.y + vert;
      const dz = camTarget.z + Math.cos(camYaw) * horiz;

      camPos.x += (dx - camPos.x) * Math.min(1, dt * 8.0);
      camPos.y += (dy - camPos.y) * Math.min(1, dt * 8.0);
      camPos.z += (dz - camPos.z) * Math.min(1, dt * 8.0);

      let sx = 0, sy = 0, sz = 0;
      if (shakeTime > 0) { sx = (Math.random()-0.5)*shakeMag; sy = (Math.random()-0.5)*shakeMag; sz = (Math.random()-0.5)*shakeMag; }
      camera.position.set(camPos.x + sx, camPos.y + sy, camPos.z + sz);
      camera.lookAt(camTarget.x, camTarget.y + 0.6, camTarget.z);
    }

    function triggerEnd(win) {
      victory = win; gameOver = !win;
      document.getElementById('end-overlay').style.display = 'flex';
      const secs = Math.floor(timeElapsed), m = Math.floor(secs / 60), s = String(secs % 60).padStart(2, '0');
      document.getElementById('end-kicker').textContent = win ? '港都 MINATO CITY // ЭВАКУАЦИЯ' : 'ПЕРЕКРЁСТОК А-3 // ПОРАЖЕНИЕ';
      document.getElementById('end-title').textContent = win ? 'ПЕРЕКРЁСТОК ЗАЧИЩЕН!' : 'ОТРЯД ПОГИБ';
      document.getElementById('end-desc').innerHTML = win
        ? `Отряд удержал перекрёсток, уничтожил Танка и вышел на эвакуацию.<br><br><b>Время:</b> ${m}:${s} &nbsp;|&nbsp; <b>Убито заражённых:</b> ${killCount} &nbsp;|&nbsp; <b>В строю:</b> ${squad.filter(u => !u.down).length}/4`
        : `Орда одолела отряд на фазе ${phase}. Используйте перекаты (SHIFT), Мед-маяк [2], Гранату [3] и пробивную Рельсу [4].<br><br><b>Убито заражённых:</b> ${killCount}`;
    }

    // --- HUD ---
    function buildSquadHUD() {
      const bar = document.getElementById('squad-bar'); bar.innerHTML = '';
      squad.forEach((u, i) => {
        const card = document.createElement('div');
        card.className = 'unit-card' + (i === activeIdx ? ' active' : ''); card.id = 'uc-' + i;
        card.addEventListener('click', () => { initAudio(); switchUnit(i); });
        card.innerHTML = `
          <div class="unit-head"><span class="unit-name" style="color:${u.color}">${u.name}</span><span class="key-badge">${i + 1}</span></div>
          <div class="hp-track"><div class="hp-fill" id="hp-${i}"></div></div>
          <div class="skill-row"><span>${u.skillName}</span><span id="cd-txt-${i}" style="color:#4ce0e8">ГОТОВ</span></div>
          <div class="cd-bar" id="cd-bar-${i}"></div>`;
        bar.appendChild(card);
      });
    }

    function updateHUD(leader) {
      document.getElementById('kill-count').textContent = killCount;
      document.getElementById('flare-count').textContent = flareAmmo;
      document.getElementById('alive-count').textContent = bossDefeated && enemies.length === 0 ? 'К ТОЧКЕ [F]!' : 'ВРАГОВ: ' + enemies.length;
      if (leader) document.getElementById('zone-name').textContent = getZoneName(leader.x, leader.z);
      squad.forEach((u, i) => {
        const card = document.getElementById('uc-' + i), hpEl = document.getElementById('hp-' + i);
        const cdTxt = document.getElementById('cd-txt-' + i), cdBar = document.getElementById('cd-bar-' + i);
        if (!card) return;
        const pct = Math.max(0, (u.hp / u.maxHp) * 100);
        hpEl.style.width = pct + '%'; hpEl.style.background = pct > 50 ? '#4ade80' : pct > 25 ? '#f5b971' : '#ff384c';
        card.classList.toggle('active', i === activeIdx); card.classList.toggle('down', u.down);
        if (u.down) { cdTxt.textContent = 'РАНЕН'; cdTxt.style.color = '#ff384c'; cdBar.style.width = '100%'; }
        else if (u.skillCd > 0) { cdTxt.textContent = u.skillCd.toFixed(1) + 'с'; cdTxt.style.color = '#f45b8a'; cdBar.style.width = ((u.skillCd / u.skillMaxCd) * 100) + '%'; }
        else { cdTxt.textContent = 'ГОТОВ'; cdTxt.style.color = '#4ce0e8'; cdBar.style.width = '0%'; }
      });
    }

    // --- Inputs ---
    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
    window.addEventListener('keydown', (e) => {
      keys[e.code] = true;
      if (e.code === 'KeyV') toggleInspect();
      if (e.code === 'Digit1') triggerSkill(0);
      if (e.code === 'Digit2') triggerSkill(1);
      if (e.code === 'Digit3') triggerSkill(2);
      if (e.code === 'Digit4') triggerSkill(3);
      if (e.code === 'KeyR' || e.code === 'KeyF') throwFlare();
      if (e.code === 'ShiftLeft' || e.code === 'ShiftRight' || e.code === 'Space') { if (running && !inspectMode) e.preventDefault(); performRoll(); }
      if (e.code === 'Tab') { e.preventDefault(); if (running) switchUnit(); }
    });
    window.addEventListener('keyup', (e) => { keys[e.code] = false; });

    renderer.domElement.addEventListener('mousemove', (e) => {
      mouseNDC.x = (e.clientX / window.innerWidth) * 2 - 1;
      mouseNDC.y = -(e.clientY / window.innerHeight) * 2 + 1;
      if (inspectMode && dragOrbit) {
        camYaw   -= (e.clientX - prevDragX) * 0.006;
        camPitch  = Math.max(0.14, Math.min(1.22, camPitch + (e.clientY - prevDragY) * 0.005));
        prevDragX = e.clientX; prevDragY = e.clientY;
      }
    });
    renderer.domElement.addEventListener('mousedown', (e) => {
      if (e.button === 0) {
        initAudio();
        if (inspectMode) { dragOrbit = true; prevDragX = e.clientX; prevDragY = e.clientY; }
        else mouseDown = true;
      }
    });
    window.addEventListener('mouseup', () => { mouseDown = false; dragOrbit = false; });
    window.addEventListener('wheel', (e) => {
      camDist = Math.max(11, Math.min(36, camDist + e.deltaY * 0.014));
    }, { passive: true });

    startBtn.addEventListener('click', () => {
      initAudio();
      document.getElementById('start-overlay').style.display = 'none';
      resetGame();
    });
    document.getElementById('restart-btn').addEventListener('click', () => { initAudio(); resetGame(); });

    // Start with dramatic animated hero preview of the Image 4 intersection!
    resetGame();
    running = false;
    camTarget.set(-1.5, 2.2, 3.0);
    camYaw = -0.14; camPitch = 0.42; camDist = 24.5;

    let lastT = performance.now();
    function animate(now) {
      requestAnimationFrame(animate);
      const dt = Math.max(0.001, Math.min(0.05, (now - lastT) / 1000));
      lastT = now;
      update(dt);
      renderer.render(scene, camera);
    }
    requestAnimationFrame(animate);
  }
})();
</script>
</body>
</html>
