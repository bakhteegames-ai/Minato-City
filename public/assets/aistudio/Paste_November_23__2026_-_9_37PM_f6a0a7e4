    // Seamless Tileable Multi-Octave FBM Noise for Realistic Wet Asphalt (ZERO Polka Dots!)
    function buildWetAsphaltTextures() {
      const size = 256;
      const hash = (x, y, p) => {
        const n = Math.sin(((x % p + p) % p) * 127.1 + ((y % p + p) % p) * 311.7 + p * 17.3) * 43758.5453;
        return n - Math.floor(n);
      };
      const vNoise = (u, v, period) => {
        const fx = u * period, fy = v * period;
        const ix = Math.floor(fx), iy = Math.floor(fy);
        const tx = fx - ix, ty = fy - iy;
        const sx = tx * tx * (3 - 2 * tx), sy = ty * ty * (3 - 2 * ty);
        const a = hash(ix, iy, period), b = hash(ix + 1, iy, period);
        const c = hash(ix, iy + 1, period), d = hash(ix + 1, iy + 1, period);
        return (a + (b - a) * sx) + ((c + (d - c) * sx) - (a + (b - a) * sx)) * sy;
      };
      const fbm = (u, v) =>
        vNoise(u, v, 4) * 0.50 + vNoise(u, v, 8) * 0.28 + vNoise(u, v, 16) * 0.14 + vNoise(u, v, 32) * 0.08;

      const cAlb = document.createElement('canvas'); cAlb.width = cAlb.height = size;
      const cRgh = document.createElement('canvas'); cRgh.width = cRgh.height = size;
      const gA = cAlb.getContext('2d'), gR = cRgh.getContext('2d');
      const imgA = gA.createImageData(size, size), imgR = gR.createImageData(size, size);

      for (let y = 0; y < size; y++) {
        for (let x = 0; x < size; x++) {
          const u = x / size, v = y / size;
          const n = fbm(u, v);
          const grain = (Math.random() - 0.5) * 10;
          // Smooth irregular puddle transition (no sharp circles!)
          const wet = Math.max(0, Math.min(1, (n - 0.47) * 5.2));
          const base = 24 - wet * 10 + grain * (1 - wet * 0.7);
          const idx = (y * size + x) * 4;
          imgA.data[idx]   = Math.max(8, base * 0.92);
          imgA.data[idx+1] = Math.max(10, base * 1.04);
          imgA.data[idx+2] = Math.max(18, base * 1.55);
          imgA.data[idx+3] = 255;

          const rough = Math.round(188 - wet * 155 + grain * 0.6);
          imgR.data[idx] = imgR.data[idx+1] = imgR.data[idx+2] = Math.max(24, Math.min(235, rough));
          imgR.data[idx+3] = 255;
        }
      }
      gA.putImageData(imgA, 0, 0);
      gR.putImageData(imgR, 0, 0);

      const map = new THREE.CanvasTexture(cAlb);
      const roughMap = new THREE.CanvasTexture(cRgh);
      if (THREE.sRGBEncoding) map.encoding = THREE.sRGBEncoding;
      [map, roughMap].forEach(t => { t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(9, 7); });
      return { map, roughMap };
    }
    const asphalt = buildWetAsphaltTextures();

