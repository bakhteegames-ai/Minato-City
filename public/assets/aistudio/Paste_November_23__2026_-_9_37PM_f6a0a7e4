        }
      }
      rainGeo.attributes.position.needsUpdate = true;

      // Sakura Petals
      petals.forEach(p => {
        p.mesh.position.x += p.vx * dt; p.mesh.position.y += p.vy * dt; p.mesh.position.z += p.vz * dt;
        p.mesh.rotation.x += dt * 2.4; p.mesh.rotation.y += dt * 1.7;
        if (p.mesh.position.y < 0.1) p.mesh.position.set(-18 + Math.random()*6, 4.8 + Math.random()*2, -22 + Math.random()*5);
      });

      if (flashLight.intensity > 0) flashLight.intensity = Math.max(0, flashLight.intensity - dt * 32);
      if (keys['KeyQ']) camYaw += 1.4 * dt;
      if (keys['KeyE']) camYaw -= 1.4 * dt;

      // Free Camera Inspection Mode!
      if (inspectMode) {
        let ix = 0, iz = 0;
        if (keys['KeyW'] || keys['ArrowUp']) iz -= 1;
        if (keys['KeyS'] || keys['ArrowDown']) iz += 1;
        if (keys['KeyA'] || keys['ArrowLeft']) ix -= 1;
        if (keys['KeyD'] || keys['ArrowRight']) ix += 1;
        if (ix || iz) {
          const c = Math.cos(camYaw), s = Math.sin(camYaw);
          camTarget.x += (ix * c + iz * s) * 14 * dt;
          camTarget.z += (-ix * s + iz * c) * 14 * dt;
